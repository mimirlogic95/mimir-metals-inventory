VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional local-development helper. These values are read only by Vite's
# development build and must identify a fictional user in the development
# Supabase project. Never commit populated values.
# In .env.local, quote a password containing # so Vite does not treat the
# remainder as a comment.
VITE_DEV_AUTH_EMAIL=
VITE_DEV_AUTH_PASSWORD=
